# Copy to .env for `docker compose up`. Values are only used on FIRST start,
# i.e. when /app/config/config.json does not exist yet.

# Client-facing key (>= 16 chars). Sent as "Authorization: Bearer <key>".
XIAOYI_API_KEY=

# Panel admin key (>= 16 chars, must differ from XIAOYI_API_KEY).
XIAOYI_ADMIN_KEY=

# Canary bucketing salt. Leave blank to generate a random one at first start.
# openssl rand -hex 32
XIAOYI_GRAY_SALT=

# Accounts to seed, as a JSON array. Leave as [] to add accounts later through
# the panel's Huawei OAuth flow instead of putting credentials in a file.
# [{"id":"gray-1","credential":"...","uid":"30086000...","deviceId":"...","refreshToken":"..."}]
XIAOYI_ACCOUNTS=[]

# Which pool the seeded accounts join: gray or stable.
XIAOYI_ACCOUNT_POOL=gray

# Canary percentage 0-100. Omit to keep the example's 10.
XIAOYI_GRAY_PERCENTAGE=

# "0" makes the panel reachable only from inside the container network.
XIAOYI_ALLOW_PANEL_LAN=1

PORT=17356
