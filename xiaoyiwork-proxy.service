[Unit]
Description=XiaoyiWork OpenAI-compatible canary proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xiaoyi-proxy
Group=xiaoyi-proxy
WorkingDirectory=/opt/xiaoyiwork-gray-proxy
ExecStart=/usr/bin/node /opt/xiaoyiwork-gray-proxy/src/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/xiaoyiwork-gray-proxy/config
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
